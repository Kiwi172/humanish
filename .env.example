# Account Warmer — environment (secrets & paths only; tuning lives in config/*.yaml)
# Copy to .env and edit. All values optional unless noted.

# --- Paths ---------------------------------------------------------------
# Data dir (db, browser profiles). Relative = resolved against project root.
WARMER_DATA_DIR=data
# Explicit DB path override (default: <data_dir>/warmer.db)
# WARMER_DB_PATH=

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO

# --- Dashboard -----------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8321

# --- Browser -------------------------------------------------------------
# chrome = real Google Chrome channel (preferred); chromium = bundled; auto = try chrome, fall back
PLAYWRIGHT_CHANNEL=auto
# false = headed window on your machine (recommended). true only if you know why.
HEADLESS=false

# --- Proxy fallback ------------------------------------------------------
# Last-resort proxy when an account has none configured. Residential/mobile strongly
# recommended for warming; datacenter IPs are the #1 shared tell across accounts (SPEC R1/R3).
# Format: http(s)://user:pass@host:port or socks5://user:pass@host:port   (socks5 preferred, hides DNS)
DEFAULT_PROXY=
